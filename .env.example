# Copy to .env for local development. Replace every angle-bracketed value.
ENVIRONMENT=development

# Outbound Market Data credential. This is not the value clients send in X-App-Key.
MARKETDATA_TOKEN=<your-marketdata-token>
# Production and Preview must use this exact upstream API root.
MARKETDATA_BASE_URL=https://api.marketdata.app/v1
# Local physical-call ceiling, reset at 00:00 UTC each day.
MARKETDATA_DAILY_CREDIT_BUDGET=90

# Inbound application credential for /api/v1 clients. Store only the lowercase SHA-256 digest;
# clients send the corresponding raw value in X-App-Key, never the Market Data provider token.
APP_ACCESS_KEY_SHA256=<64-character-lowercase-sha256-hex>
SESSION_SECRET=<random-session-signing-secret>

UPSTASH_REDIS_REST_URL=<https://your-database.upstash.io>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

ALLOWED_ORIGIN=<http://localhost:8000>
ALLOWED_HOSTS=<localhost,127.0.0.1,testserver>
SESSION_COOKIE_SECURE=false
HTTP_TIMEOUT_SECONDS=8

# Ticker autocomplete uses a separately refreshed SEC directory cached in Redis. Identify your
# application and a monitored contact address when running refresh or filing ingestion, for example:
# MarketView/1.0 operations@example.com
SEC_USER_AGENT=
SYMBOL_INDEX_SCHEMA_VERSION=v1
SYMBOL_DIRECTORY_MAX_AGE_SECONDS=86400
SYMBOL_SEARCH_RATE_LIMIT=30

# SEC filing research is opt-in and disabled by default. The three provider values below are an
# all-or-none group even while disabled: uncomment and replace all three together, never one at a
# time. Upstash Vector is a separate resource; do not reuse the Redis URL or token.
RESEARCH_ENABLED=false
RESEARCH_MAX_QUESTION_CHARS=500
RESEARCH_MAX_REQUEST_BYTES=4096
RESEARCH_TIMEOUT_SECONDS=8
RESEARCH_RATE_LIMIT=10
RESEARCH_DAILY_GLOBAL_LIMIT=100

# OPENAI_API_KEY=<your-openai-project-api-key>
# UPSTASH_VECTOR_REST_URL=<https://your-vector-index.upstash.io>
# UPSTASH_VECTOR_REST_TOKEN=<your-separate-vector-rest-token>

RESEARCH_EMBEDDING_PROVIDER=openai
RESEARCH_EMBEDDING_MODEL=text-embedding-3-small
RESEARCH_EMBEDDING_DIMENSIONS=1536
RESEARCH_GENERATION_PROVIDER=openai
RESEARCH_GENERATION_MODEL=gpt-5.6-luna
RESEARCH_GENERATION_MAX_OUTPUT_TOKENS=700
RESEARCH_VECTOR_PROVIDER=upstash
RESEARCH_VECTOR_NAMESPACE=sec-filings-v1
RESEARCH_INDEX_SCHEMA_VERSION=v1
RESEARCH_CHUNK_TOKENS=800
RESEARCH_CHUNK_OVERLAP_TOKENS=100
RESEARCH_MAX_RESULTS=5
RESEARCH_VECTOR_OVERFETCH=4
# This starting threshold must be recalibrated against the fixed evaluation set before scale-up.
RESEARCH_MINIMUM_SCORE=0.70
