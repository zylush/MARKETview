# Copy to .env for local development. Replace every angle-bracketed value.
ENVIRONMENT=development

# Outbound Marketstack v2 credential. This is not the value clients send in X-App-Key.
# MARKETSTACK_ACCESS_KEY is a deprecated compatibility alias; do not define both names.
MARKETSTACK_API_KEY=<your-marketstack-api-key>
# Production must use this exact upstream API root. Omit the variable to use the safe default.
MARKETSTACK_BASE_URL=https://api.marketstack.com/v2
MARKETSTACK_MONTHLY_BUDGET=90

# Inbound application credential for /api/v1 clients. Store only the lowercase SHA-256 digest;
# clients send the corresponding raw value in X-App-Key, never the Marketstack provider key.
APP_ACCESS_KEY_SHA256=<64-character-lowercase-sha256-hex>
SESSION_SECRET=<random-session-signing-secret>

UPSTASH_REDIS_REST_URL=<https://your-database.upstash.io>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

ALLOWED_ORIGIN=<http://localhost:8000>
ALLOWED_HOSTS=<localhost,127.0.0.1,testserver>
SESSION_COOKIE_SECURE=false
HTTP_TIMEOUT_SECONDS=8
