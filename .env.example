# Copy to .env for local development. Replace every angle-bracketed value.
ENVIRONMENT=development

# Outbound Market Data credential. This is not the value clients send in X-App-Key.
MARKETDATA_TOKEN=<your-marketdata-token>
# Production and Preview must use this exact upstream API root.
MARKETDATA_BASE_URL=https://api.marketdata.app/v1
# Local physical-call ceiling, reset at 00:00 UTC each day.
MARKETDATA_DAILY_CREDIT_BUDGET=90

# Inbound application credential for /api/v1 clients. Store only the lowercase SHA-256 digest;
# clients send the corresponding raw value in X-App-Key, never the Market Data provider token.
APP_ACCESS_KEY_SHA256=<64-character-lowercase-sha256-hex>
SESSION_SECRET=<random-session-signing-secret>

UPSTASH_REDIS_REST_URL=<https://your-database.upstash.io>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

ALLOWED_ORIGIN=<http://localhost:8000>
ALLOWED_HOSTS=<localhost,127.0.0.1,testserver>
SESSION_COOKIE_SECURE=false
HTTP_TIMEOUT_SECONDS=8

# Ticker autocomplete uses a separately refreshed SEC company directory cached in Redis. Identify
# your application and a monitored contact address when running the symbol refresh, for example:
# MarketView/1.0 operations@example.com
SEC_USER_AGENT=
SYMBOL_INDEX_SCHEMA_VERSION=v1
SYMBOL_DIRECTORY_MAX_AGE_SECONDS=86400
SYMBOL_SEARCH_RATE_LIMIT=30

# MarketView AI analysis is opt-in and disabled by default. It sends a bounded set of collected
# Market Data facts and server-verified calculations to one OpenAI Responses API call. It does not
# use embeddings, a vector database, filing retrieval, or a RAG corpus.
RESEARCH_ENABLED=false
RESEARCH_MAX_QUESTION_CHARS=500
RESEARCH_MAX_REQUEST_BYTES=4096
RESEARCH_TIMEOUT_SECONDS=8
RESEARCH_RATE_LIMIT=10
RESEARCH_DAILY_GLOBAL_LIMIT=100

# OPENAI_API_KEY=<your-openai-project-api-key>

RESEARCH_GENERATION_PROVIDER=openai
RESEARCH_GENERATION_MODEL=gpt-5.6-luna
RESEARCH_GENERATION_MAX_OUTPUT_TOKENS=700
